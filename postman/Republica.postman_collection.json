{
  "info": {
    "name": "República — Tema 10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute em ordem com banco novo. Tokens e IDs são preenchidos automaticamente. Ajuste mês e sufixo para uma nova demonstração."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sufixo",
      "value": "20261016"
    },
    {
      "key": "mes",
      "value": "2026-10"
    },
    {
      "key": "mesRecorrencia",
      "value": "2026-11"
    }
  ],
  "item": [
    {
      "name": "01 - Cadastrar ana",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/cadastro",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana\",\n  \"email\": \"ana{{sufixo}}@exemplo.com\",\n  \"senha\": \"senha12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
